# yStream BETA proxy — wrangler configuration example.
# Copy to wrangler.toml and run `npx wrangler deploy` (or `wrangler publish`).
#
# NOTE: this is a NEW, dedicated Worker that ONLY serves the /beta routes.
# It never touches the production TMDB Worker (screenify-worker…).

name = "screenify-beta-proxy"
main = "worker.js"
compatibility_date = "2024-09-01"

# Env vars (all optional):
#  DEFAULT_PROVIDER : "videasy" | "vidking"   (used when a request omits ?provider=)
#  REFERER          : upstream Referer to send, e.g. "https://player.videasy.net/"
#                     (leave unset to mirror the site's no-referrer policy)
#  STATIC_ORIGIN    : REQUIRED with wildcard routes. Lets the Worker pass
#                     through the /beta/player/ and /beta/proxy/ module files
#                     that a trailing-* pattern would otherwise swallow.
[vars]
DEFAULT_PROVIDER = "videasy"
STATIC_ORIGIN = "yassinabdelaziz.github.io"
# REFERER = "https://player.videasy.net/"

# ---- Routes on the custom domain (cloudflare-proxied) ---------------------
# IMPORTANT: Cloudflare route patterns consider the ENTIRE URL including the
# query string, so every pattern MUST end with "*" — the beta embed URLs always
# carry ?provider=... and an exact pattern like "/beta/player" silently fails
# to match them. The trailing-* also swallows /beta/player/ and /beta/proxy/
# client-module files; STATIC_ORIGIN above lets the Worker pass those through.
routes = [
  { pattern = "ystream.dpdns.org/beta/healthz*", zone_id = "YOUR_ZONE_ID" },
  { pattern = "ystream.dpdns.org/beta/player*",  zone_id = "YOUR_ZONE_ID" },
  { pattern = "ystream.dpdns.org/beta/proxy*",   zone_id = "YOUR_ZONE_ID" }
]
